// Prisma schema.
// Lottery selection, weighting, historical participation and winner
// processing are intentionally deferred to later steps. So far this covers
// the geographic hierarchy (wilaya/commune), the participant identity
// registry, administrator authentication, and annual applications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One of Algeria's 69 wilayas (provinces).
model Wilaya {
  id        String    @id @default(cuid())
  /// Official numeric wilaya code (e.g. "16" for Algiers).
  code      String    @unique
  nameAr    String    @map("name_ar")
  nameFr    String    @map("name_fr")
  /// No official English name exists; this holds the established Latin/French
  /// transliteration (nameFr) rather than an invented translation.
  nameEn    String    @map("name_en")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  communes  Commune[]
  admins    User[]
  auditLogs AuditLog[]
  approvals ApprovalRequest[]

  @@map("wilayas")
}

/// One of Algeria's 1541 communes, each belonging to exactly one wilaya.
/// Each commune later runs its own independent lottery draw.
model Commune {
  id           String        @id @default(cuid())
  wilayaId     String        @map("wilaya_id")
  /// Official numeric commune code, unique within its wilaya.
  code         String
  nameAr       String        @map("name_ar")
  nameFr       String        @map("name_fr")
  /// No official English name exists; this holds the established Latin/French
  /// transliteration (nameFr) rather than an invented translation.
  nameEn       String        @map("name_en")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  wilaya       Wilaya                 @relation(fields: [wilayaId], references: [id])
  admins        User[]
  applications  Application[]
  history       ParticipationHistory[]
  draws         CommuneDraw[]
  winnerArchive WinnerArchive[]
  legacyWinners LegacyWinner[]
  importRows    ImportRow[]
  auditLogs     AuditLog[]
  approvals     ApprovalRequest[]

  @@unique([wilayaId, code])
  /// Redundant on its own (id is already unique), but it gives User a
  /// composite foreign key target so PostgreSQL can enforce that an
  /// administrator's commune really belongs to their wilaya.
  @@unique([id, wilayaId])
  @@index([wilayaId])
  @@map("communes")
}

/// One real individual — the single identity record for one national ID.
///
/// A participant answers "who is this person?", never "how are they taking
/// part this year?". Draw year, commune, application status, computed weight
/// and entry type live on Application, which references this record instead
/// of duplicating the person.
model Participant {
  id String @id @default(cuid())

  /// Algeria's Numéro d'Identification National, stored as the canonical
  /// 18-digit string produced by normalizeNationalId() — never a numeric
  /// type, so leading zeros survive. Uniqueness is enforced by PostgreSQL,
  /// not only by application code.
  nationalId String @unique @map("national_id")

  fullName String   @map("full_name")
  /// Date only; no time component, no timezone shifting.
  dob      DateTime @db.Date

  /// Contact information, never a credential. Stored in the canonical
  /// +213XXXXXXXXX form produced by normalizePhoneNumber(), so one person
  /// cannot become two identities by typing 0555… one year and +213555…
  /// the next.
  phoneNumber String? @map("phone_number")

  /// Reserved for a future verification flow. Nothing sets it yet — there is
  /// no OTP in this system, and a phone number is not proof of identity.
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  /// Permanent state: a past Hajj winner is excluded from future draws.
  /// Set transactionally by the later winner-processing step, never here.
  hasWonHajj Boolean @default(false) @map("has_won_hajj")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  primaryApplications   Application[]            @relation("PrimaryApplicant")
  secondaryApplications Application[]            @relation("SecondaryApplicant")
  participations        ApplicationParticipant[]
  history               ParticipationHistory[]
  poolEntriesAsPrimary   DrawPoolEntry[]         @relation("PoolPrimary")
  poolEntriesAsSecondary DrawPoolEntry[]         @relation("PoolSecondary")
  winsAsPrimary          DrawWinner[]            @relation("WinnerPrimary")
  winsAsSecondary        DrawWinner[]            @relation("WinnerSecondary")
  /// At most one, ever — a person wins the Hajj lottery once in their life.
  winnerArchive          WinnerArchive?
  /// The pre-platform counterpart, and equally at most one.
  legacyWinner           LegacyWinner?
  importRows             ImportRow[]

  @@map("participants")
}

/// Administrative hierarchy. Kept as a database enum so a role can only ever
/// be one of these values — never arbitrary user input. Mirrors ADMIN_ROLES
/// in shared/src/roles.ts; the server asserts the two agree at compile time.
enum AdminRole {
  SUPER_ADMIN
  WILAYA_ADMIN
  COMMUNE_ADMIN

  @@map("admin_role")
}

/// An administrator who can sign in to the admin portal.
///
/// Geographic scope is stored here and is the *only* authoritative source of
/// what this administrator may reach. It is never taken from the request.
model User {
  id String @id @default(cuid())

  /// Login identifier. Stored lowercase so it is effectively case-insensitive.
  username String @unique

  /// argon2id digest — never a plaintext or reversible value.
  passwordHash String @map("password_hash")

  role AdminRole

  /// Deactivated administrators keep their record but cannot authenticate.
  isActive Boolean @default(true) @map("is_active")

  /// Geographic scope, by role:
  ///   SUPER_ADMIN    both NULL           (national)
  ///   WILAYA_ADMIN   wilayaId only
  ///   COMMUNE_ADMIN  both set
  /// A CHECK constraint (see the migration) rejects any other combination.
  wilayaId  String? @map("wilaya_id")
  communeId String? @map("commune_id")

  /// Restrict, not Cascade: deleting geography must never silently widen or
  /// destroy an administrator's scope.
  wilaya Wilaya? @relation(fields: [wilayaId], references: [id], onDelete: Restrict)

  /// Composite reference on purpose. Pointing at (id, wilayaId) makes
  /// PostgreSQL reject a commune that belongs to a different wilaya than the
  /// one assigned here — the inconsistency cannot be written at all. With a
  /// NULL commune (SUPER_ADMIN, WILAYA_ADMIN) the constraint simply does not
  /// apply.
  commune Commune? @relation(fields: [communeId, wilayaId], references: [id, wilayaId], onDelete: Restrict)

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  auditLogs         AuditLog[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalsReviewed  ApprovalRequest[] @relation("ApprovalReviewer")
  importsUploaded    ImportBatch[]     @relation("ImportUploader")
  importsApproved    ImportBatch[]     @relation("ImportApprover")

  @@index([wilayaId])
  @@index([communeId])
  @@map("users")
}

/// A server-side administrator session.
///
/// The cookie carries an opaque 256-bit token; only its SHA-256 digest is
/// stored here, so a leaked database dump cannot be replayed as a live
/// session. Deleting the row revokes the session immediately.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// How a citizen takes part in a given year's draw.
enum EntryType {
  /// One applicant, alone.
  SINGLE
  /// Two applicants who travel together and share one outcome.
  PAIRED

  @@map("entry_type")
}

/// Lifecycle of an annual application.
///
/// Only the server writes this: it is the conclusion of EligibilityService for
/// the first three, and of a concluded draw for the last two. Never a field a
/// client can set.
enum ApplicationStatus {
  /// Received, not yet evaluated.
  PENDING
  /// Evaluated and allowed to take part in its commune's draw.
  ELIGIBLE
  /// Evaluated and refused. The reasons are not stored — they are derived on
  /// demand, so a stale copy can never contradict the current facts.
  INELIGIBLE
  /// Drawn from its commune's frozen pool. Written only by winner processing,
  /// in the same transaction as the winner records.
  SELECTED
  /// Entered the frozen pool and was not drawn. A final outcome, not a refusal:
  /// this application was a full participant in the lottery.
  NOT_SELECTED

  @@map("application_status")
}

enum ApplicationRole {
  PRIMARY
  SECONDARY

  @@map("application_role")
}

/// One citizen's participation in one draw year, in exactly one commune.
///
/// Identity is never copied here: names, national IDs, dates of birth and
/// phone numbers live on Participant, and this record points at them.
model Application {
  id String @id @default(cuid())

  /// Citizen-facing receipt, e.g. HZ-2027-MES-8F42K1. Random rather than
  /// sequential, and carries no database id and no national ID.
  applicationReference String @unique @map("application_reference")

  /// Always the server's current draw year — never a value from the browser.
  drawYear Int @map("draw_year")

  communeId String @map("commune_id")

  primaryParticipantId   String  @map("primary_participant_id")
  secondaryParticipantId String? @map("secondary_participant_id")

  entryType EntryType         @map("entry_type")
  status    ApplicationStatus @default(PENDING)

  /// The application's lottery weight, once frozen. NULL means "not yet
  /// calculated" — it is a snapshot written by an explicit freeze, never a
  /// value that recomputes itself when history changes underneath it.
  ///
  /// An integer, because a weight is a count of years and nothing here needs
  /// fractions. A CHECK keeps it positive: a zero-weight application could
  /// never be drawn, which would make it ineligible by arithmetic rather than
  /// by the eligibility rules.
  calculatedWeight Int? @map("calculated_weight")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commune              Commune                  @relation(fields: [communeId], references: [id], onDelete: Restrict)
  primaryParticipant   Participant              @relation("PrimaryApplicant", fields: [primaryParticipantId], references: [id], onDelete: Restrict)
  secondaryParticipant Participant?             @relation("SecondaryApplicant", fields: [secondaryParticipantId], references: [id], onDelete: Restrict)
  participants         ApplicationParticipant[]
  poolEntries          DrawPoolEntry[]
  drawWins             DrawWinner[]

  /// Catch same-role duplicates directly. The cross-role case (someone
  /// primary on one application and secondary on another in the same year)
  /// is caught by ApplicationParticipant's primary key.
  @@unique([drawYear, primaryParticipantId])
  @@unique([drawYear, secondaryParticipantId])
  /// Target for ApplicationParticipant's composite foreign key, so a
  /// participation row can never claim a different year than its application.
  @@unique([id, drawYear])
  @@index([drawYear, communeId])
  @@map("applications")
}

/// The annual registration cycle's state.
///
/// This is the *national* lifecycle only: whether citizens may apply this
/// year. What each commune's own draw is doing is CommuneDrawStatus, and the
/// two move independently — a year can be open for registration while every
/// commune draw is still a draft.
///
/// Deliberately short. States belonging to draw execution (preparing,
/// completed) are absent because no code can reach them yet; adding them now
/// would be inventing a lifecycle rather than recording one.
enum DrawYearStatus {
  /// Being configured. Registration is not running.
  DRAFT
  /// Citizens may submit applications. At most one year may be here at a time.
  REGISTRATION_OPEN
  /// Intake has finished. There is no route back — reopening is a policy
  /// decision nobody has made.
  REGISTRATION_CLOSED
  /// Kept for the record, no longer operational. Draw years are archived
  /// rather than deleted: they are the history of who ran which lottery.
  ARCHIVED

  @@map("draw_year_status")
}

/// One annual lottery cycle.
///
/// The authoritative answer to "which year is registration for?" — replacing
/// the environment-variable placeholder that stood in for it. Exactly one year
/// may be REGISTRATION_OPEN, enforced by a partial unique index in the
/// migration, so the question can never have two answers.
model DrawYear {
  id String @id @default(cuid())

  /// The calendar year of the pilgrimage draw. One cycle per year, ever.
  year Int @unique

  status DrawYearStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  communeDraws CommuneDraw[]

  @@map("draw_years")
}

/// Where one commune's draw stands, independently of the national cycle.
enum CommuneDrawStatus {
  /// Being configured. Spots may still change.
  DRAFT
  /// Configuration is settled and intake continues. Spots may still change.
  READY
  /// Allocation is fixed. Nothing may change the spots after this, and no
  /// further applications join this commune's pool.
  LOCKED
  /// The draw has been executed and its winners are recorded. Terminal, and
  /// reachable only through winner processing: a deferred constraint trigger
  /// refuses to commit this status without a matching draw result, so it cannot
  /// be set administratively to fake a concluded draw.
  ///
  /// There is deliberately no DRAW_IN_PROGRESS. Execution claims this state and
  /// writes every winner in one transaction, so an intermediate state would be
  /// invisible to every reader and rolled back by any failure — a lifecycle
  /// value nothing could ever observe. See docs/winner-processing.md.
  COMPLETED
  /// Called off for this year. Terminal.
  CANCELLED

  @@map("commune_draw_status")
}

/// One commune's lottery for one draw year.
///
/// The draw is run per commune, so this is where the number of Hajj places is
/// configured — and it is *configuration*, never a calculation. Spots are not
/// derived from how many people applied, from population, or from past
/// winners; an official allocates them, and the system records what was
/// allocated.
///
/// A commune with no record here is not running a draw that year, and
/// registration refuses it rather than accepting applications into a lottery
/// that does not exist.
model CommuneDraw {
  id String @id @default(cuid())

  drawYearId String @map("draw_year_id")
  communeId  String @map("commune_id")

  /// How many winners this commune's draw may select. A positive integer,
  /// bounded by a CHECK constraint. Never inferred from the applicant count:
  /// 843 eligible applications for 12 places is the normal case, and so is
  /// 100 places for 20 applicants.
  allocatedSpots Int @map("allocated_spots")

  status CommuneDrawStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Restrict, not Cascade, on both sides. These records are the configuration
  /// a lottery was run under; deleting geography or a year must never quietly
  /// erase the terms of a past draw.
  drawYear DrawYear @relation(fields: [drawYearId], references: [id], onDelete: Restrict)
  /// Wilaya is deliberately not copied here — the commune already determines
  /// it, and geographic authorization reads it through this relation.
  commune  Commune  @relation(fields: [communeId], references: [id], onDelete: Restrict)

  /// The frozen draw input, once this commune locks. At most one, ever.
  pool DrawPool?

  /// The executed draw, once it has been run. At most one, ever — and a
  /// deferred constraint trigger refuses to let this commune draw commit as
  /// COMPLETED without it.
  result DrawResult?

  /// One configuration per commune per year.
  @@unique([drawYearId, communeId])
  @@index([communeId])
  @@map("commune_draws")
}

/// The frozen input to one commune's lottery.
///
/// The draw must never read live application rows. Eligibility, weights and
/// history all keep moving — a legacy record verified next week changes what a
/// streak would be — and a lottery run against data shifting underneath it
/// could not be reproduced or defended afterwards. So the moment a commune
/// locks, exactly what will be drawn from is copied here and never touched
/// again.
///
/// Immutability is enforced by database triggers, not only by the absence of
/// an update endpoint: UPDATE and DELETE on this table and its entries raise
/// an exception. The pool is evidence, and evidence that can be edited is not
/// evidence.
model DrawPool {
  id String @id @default(cuid())

  /// One pool per commune draw, ever. This unique constraint is also what
  /// makes two administrators freezing simultaneously resolve to one pool.
  communeDrawId String      @unique @map("commune_draw_id")
  communeDraw   CommuneDraw @relation(fields: [communeDrawId], references: [id], onDelete: Restrict)

  /// How many applications the draw will choose from, and their weights
  /// summed. Both are validated against the entries as they are written, and
  /// can never drift afterwards because nothing can rewrite either.
  entryCount  Int @map("entry_count")
  totalWeight Int @map("total_weight")

  /// The commune's allocation as it stood at the moment of freezing, so the
  /// terms of the draw are legible from the snapshot alone.
  allocatedSpots Int @map("allocated_spots")

  /// SHA-256 over a deterministic serialization of the pool — see
  /// lib/draw-pool-hash.ts. An integrity and identification mechanism only:
  /// it is emphatically *not* a random seed, and the draw must not use it as
  /// one.
  snapshotHash String @map("snapshot_hash")

  /// The canonical format this hash was computed under, so a future change to
  /// the serialization can be told apart from tampering.
  snapshotVersion Int @default(1) @map("snapshot_version")

  createdAt DateTime @default(now()) @map("created_at")

  entries DrawPoolEntry[]
  /// The draw run against this pool. At most one.
  result  DrawResult?

  @@map("draw_pools")
}

/// One application's frozen place in a commune's draw.
///
/// Carries what the lottery needs and nothing else: which application, which
/// participants, what weight, what kind of entry. No names, national IDs,
/// dates of birth or phone numbers — the draw does not need to know who
/// anybody is to choose between them, and a snapshot that outlives everything
/// else is the worst possible place to keep identity.
model DrawPoolEntry {
  id String @id @default(cuid())

  drawPoolId String   @map("draw_pool_id")
  drawPool   DrawPool @relation(fields: [drawPoolId], references: [id], onDelete: Restrict)

  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  /// Copied rather than joined, so the pool reads without touching live rows.
  applicationReference String    @map("application_reference")
  entryType            EntryType @map("entry_type")

  /// Internal ids only. Restrict on both: a participant cannot be deleted out
  /// from under a draw that has already been run.
  primaryParticipantId   String       @map("primary_participant_id")
  primaryParticipant     Participant  @relation("PoolPrimary", fields: [primaryParticipantId], references: [id], onDelete: Restrict)
  secondaryParticipantId String?      @map("secondary_participant_id")
  secondaryParticipant   Participant? @relation("PoolSecondary", fields: [secondaryParticipantId], references: [id], onDelete: Restrict)

  /// The application's frozen calculated_weight, copied at freeze time. A
  /// CHECK keeps it positive: an entry that can never be drawn is not an entry.
  weight Int

  createdAt DateTime @default(now()) @map("created_at")

  /// Whether this entry was drawn lives here, in the result — never as a flag on
  /// the entry itself. The pool is the input to a lottery and stays exactly as
  /// it was frozen; marking entries selected would edit the evidence.
  win             DrawWinner?
  selectionEvents DrawSelectionEvent[]
  winnerArchive   WinnerArchive[]

  /// An application appears at most once in a pool. Belt and braces alongside
  /// the one-application-per-person-per-year guarantee upstream.
  @@unique([drawPoolId, applicationId])
  @@index([drawPoolId])
  @@map("draw_pool_entries")
}

/// One commune's executed lottery.
///
/// The authoritative record that a draw happened, under which terms, against
/// which frozen input, and by which algorithm. `UNIQUE(commune_draw_id)` is what
/// makes "who won this commune's draw?" have exactly one answer: there is no
/// second result set to disagree with, ever.
///
/// Written once, inside the transaction that claims the commune draw and records
/// every winner. Immutable afterwards, by trigger.
model DrawResult {
  id String @id @default(cuid())

  /// One result per commune draw, ever — the constraint that makes a second
  /// independent execution impossible rather than merely discouraged.
  communeDrawId String      @unique @map("commune_draw_id")
  communeDraw   CommuneDraw @relation(fields: [communeDrawId], references: [id], onDelete: Restrict)

  /// The pool actually drawn from. Also unique: a frozen pool produces at most
  /// one result.
  drawPoolId String   @unique @map("draw_pool_id")
  drawPool   DrawPool @relation(fields: [drawPoolId], references: [id], onDelete: Restrict)

  /// How many entries were selected. Entries, not people: a paired application
  /// is one winning entry and two winning individuals. Equal to the commune's
  /// allocated spots for a completed draw.
  winnerCount Int @map("winner_count")

  /// The pool's total weight as the draw saw it. Stored so the selection events
  /// can be replayed without reading the pool back.
  totalWeightAtDraw Int @map("total_weight_at_draw")

  /// The pool's snapshot hash, verified immediately before selection and copied
  /// here. Identifies the exact input this result came from — and is emphatically
  /// not a seed.
  poolHash String @map("pool_hash")

  /// Which implementation selected these winners, e.g. `weighted-csprng-v1`.
  /// Never a moving value like "latest": a completed draw must forever identify
  /// the algorithm it ran under, because that is what makes it reproducible.
  algorithmVersion String @map("algorithm_version")

  /// When execution began and when the result was written. Both, so how long a
  /// draw took is part of its record.
  startedAt   DateTime @map("started_at")
  completedAt DateTime @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// No status column. A result row exists only when a draw completed, so a
  /// status could only ever read COMPLETED — the lifecycle lives on the commune
  /// draw, and a second copy of it here could disagree.
  winners         DrawWinner[]
  events          DrawSelectionEvent[]
  archivedWinners WinnerArchive[]

  @@map("draw_results")
}

/// One selected pool entry.
///
/// A winning *entry*, not a winning person: a paired application produces one of
/// these and two `WinnerArchive` rows. Carries internal ids only — no names,
/// national IDs, dates of birth or phone numbers. A test pins those columns out.
model DrawWinner {
  id String @id @default(cuid())

  drawResultId String     @map("draw_result_id")
  drawResult   DrawResult @relation(fields: [drawResultId], references: [id], onDelete: Restrict)

  /// The frozen entry that was drawn. Unique on its own: an entry can win once,
  /// ever, in any result.
  drawPoolEntryId String        @unique @map("draw_pool_entry_id")
  drawPoolEntry   DrawPoolEntry @relation(fields: [drawPoolEntryId], references: [id], onDelete: Restrict)

  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  primaryParticipantId   String       @map("primary_participant_id")
  primaryParticipant     Participant  @relation("WinnerPrimary", fields: [primaryParticipantId], references: [id], onDelete: Restrict)
  secondaryParticipantId String?      @map("secondary_participant_id")
  secondaryParticipant   Participant? @relation("WinnerSecondary", fields: [secondaryParticipantId], references: [id], onDelete: Restrict)

  /// Position in the order the entries were drawn, 1-based and contiguous. The
  /// order of selection, deliberately not a rank: nothing in the domain ranks
  /// winners against each other.
  selectionOrder Int @map("selection_order")

  /// The weight this entry carried in the pool, copied so a result reads without
  /// touching the pool.
  selectedWeight Int @map("selected_weight")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([drawResultId, drawPoolEntryId])
  /// No two winners share a position in the order.
  @@unique([drawResultId, selectionOrder])
  @@index([drawResultId])
  @@map("draw_winners")
}

/// The random draw behind one selection.
///
/// `random_value` was drawn from `[0, active_total_weight)` — a CHECK constraint
/// holds that half-open range — and picked the entry whose cumulative slice
/// contains it. Together with the pool, these events let anyone replay the
/// arithmetic and confirm each winner without trusting the software.
///
/// Normalized rather than a JSON blob so the events can be queried, counted and
/// constrained. They are a record of randomness already spent; nothing may use
/// them as a source of randomness.
model DrawSelectionEvent {
  id String @id @default(cuid())

  drawResultId String     @map("draw_result_id")
  drawResult   DrawResult @relation(fields: [drawResultId], references: [id], onDelete: Restrict)

  selectionOrder    Int @map("selection_order")
  /// The entries still in play, summed, before this selection.
  activeTotalWeight Int @map("active_total_weight")
  randomValue       Int @map("random_value")

  selectedPoolEntryId String        @map("selected_pool_entry_id")
  selectedPoolEntry   DrawPoolEntry @relation(fields: [selectedPoolEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([drawResultId, selectionOrder])
  @@index([drawResultId])
  @@map("draw_selection_events")
}

/// One person's lifetime Hajj win.
///
/// The participant-centric index of winners, distinct from `DrawWinner`, which is
/// entry-centric. A paired winning application produces one `DrawWinner` and
/// **two** rows here, because lifetime exclusion applies to people.
///
/// `UNIQUE(participant_id)` is the strongest invariant in the model: a person can
/// be archived as a winner exactly once, in one draw, forever. A malformed pool
/// naming the same participant twice cannot be half-processed — the constraint
/// aborts the whole transaction rather than letting anything be deduplicated
/// quietly.
model WinnerArchive {
  id String @id @default(cuid())

  /// One win per person, ever.
  participantId String      @unique @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// The year and commune of the win, stored as the participation ledger stores
  /// them: a person belongs to no commune permanently, so the commune is a
  /// property of the draw they won, not of them.
  drawYear  Int     @map("draw_year")
  communeId String  @map("commune_id")
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Restrict)

  drawResultId String     @map("draw_result_id")
  drawResult   DrawResult @relation(fields: [drawResultId], references: [id], onDelete: Restrict)

  /// The winning entry, which determines the application. Not copied separately.
  drawPoolEntryId String        @map("draw_pool_entry_id")
  drawPoolEntry   DrawPoolEntry @relation(fields: [drawPoolEntryId], references: [id], onDelete: Restrict)

  /// When the draw that selected this person completed.
  drawnAt DateTime @map("drawn_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([drawResultId, participantId])
  @@index([drawYear])
  @@index([communeId, drawYear])
  @@map("winner_archive")
}

/// The privileged actions worth a permanent record.
///
/// An enum rather than free strings so the catalogue is closed: an action either
/// exists here or cannot be logged, which is what makes the trail queryable and
/// stops a typo becoming a category nobody notices.
///
/// Only actions something can actually perform are listed. Participant identity
/// correction and winner correction are absent because the operations they would
/// describe do not exist — a catalogue of events that never fire reads like
/// coverage while providing none.
enum AuditAction {
  /// Authentication. A failure carries no actor: the account may not exist, and
  /// saying which is which would answer the question the login route refuses to.
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT

  /// Administrator accounts. ADMIN_CREATED covers the bootstrap, where the actor
  /// is null because nobody was authenticated — the appearance of the first
  /// SUPER_ADMIN is precisely the event worth recording.
  ADMIN_CREATED
  ADMIN_DISABLED
  ADMIN_SCOPE_CHANGED

  /// Draw configuration. The status transition lives in the before/after
  /// snapshot rather than in separate OPENED/CLOSED actions, so there is one
  /// account of what changed instead of two that could disagree.
  DRAW_YEAR_CREATED
  DRAW_YEAR_STATUS_CHANGED
  COMMUNE_DRAW_CREATED
  COMMUNE_DRAW_UPDATED

  /// The lottery. Freezing locks the commune draw in the same transaction, so
  /// DRAW_POOL_FROZEN is the record of both.
  DRAW_POOL_FROZEN
  COMMUNE_DRAW_EXECUTED

  /// The participation ledger. Only corrections — a concluded draw writes
  /// hundreds of records at once, and the execution event is their provenance.
  HISTORICAL_RECORD_CORRECTED

  /// The legacy import. Four events because the four moments differ in actor and
  /// in consequence: uploading stages nothing authoritative, approving still
  /// writes nothing, and only completion changes what a future lottery sees.
  LEGACY_IMPORT_CREATED
  LEGACY_IMPORT_APPROVED
  LEGACY_IMPORT_REJECTED
  LEGACY_IMPORT_COMPLETED

  /// Separation of duties.
  APPROVAL_CREATED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_CANCELLED

  @@map("audit_action")
}

/// What kind of thing an audit record or approval request is about.
///
/// Paired with a `target_id` that is deliberately **not** a foreign key: an
/// audit record must outlive whatever it describes, and eight nullable
/// references would make the trail's durability depend on nothing ever being
/// removed. The type keeps the untyped id interpretable.
enum AuditTargetType {
  USER
  DRAW_YEAR
  COMMUNE_DRAW
  DRAW_POOL
  DRAW_RESULT
  PARTICIPATION_HISTORY
  APPROVAL_REQUEST
  IMPORT_BATCH

  @@map("audit_target_type")
}

/// One privileged action, recorded permanently.
///
/// Audit rows are not application data. Application data describes what is true
/// now and changes when the truth changes; an audit row describes what somebody
/// did, which never stops being what they did. So nothing updates or deletes
/// these — triggers refuse both — and there is no endpoint that could.
model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  /// Who did it. Null only where no account was authenticated: a failed login,
  /// or the bootstrap that creates the first administrator. Never taken from a
  /// request body — always the session's user.
  actorUserId String? @map("actor_user_id")
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  /// What it was about. See AuditTargetType for why the id is not a foreign key.
  targetType AuditTargetType @map("target_type")
  targetId   String?         @map("target_id")

  /// The geography the action concerned, derived from the target and the actor's
  /// own scope — never from the request. Both null means a national action,
  /// which scoped administrators deliberately cannot see.
  wilayaId  String?  @map("wilaya_id")
  wilaya    Wilaya?  @relation(fields: [wilayaId], references: [id], onDelete: Restrict)
  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: Restrict)

  /// Why, in a human's words. Required for sensitive mutations, refused blank.
  reason String?

  /// Limited field snapshots, built by the audit service from typed payloads —
  /// never a raw request body. National IDs, phone numbers, names, dates of
  /// birth, password hashes and tokens are refused outright, not masked.
  beforeData Json? @map("before_data")
  afterData  Json? @map("after_data")
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  /// Indexed for the queries the audit API actually offers: a timeline, and that
  /// timeline narrowed by actor, action or territory.
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([wilayaId, createdAt])
  @@index([communeId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// What a sensitive change can be requested for.
///
/// One member, because one such flow exists. Participant identity and winner
/// corrections belong here when they are built; adding their names now would
/// mean a request could be raised that nothing could ever apply.
enum ApprovalType {
  HISTORICAL_RECORD_CORRECTION

  @@map("approval_type")
}

/// Where a request stands. Terminal in every case but PENDING.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the requester before anybody reviewed it.
  CANCELLED

  @@map("approval_status")
}

/// A sensitive change somebody has asked for, and what was decided.
///
/// Separation of duties made structural: a scoped administrator who can see a
/// record they believe is wrong cannot rewrite it, only ask. The decision is
/// somebody else's, enforced by a CHECK constraint rather than by a rule in the
/// service that a later refactor could drop.
///
/// The request half is immutable from the moment it is made, and the decision
/// half from the moment it is taken — a trigger refuses to rewrite either. There
/// is no path from APPROVED to REJECTED or back: a changed mind is a new
/// request, so the original decision stays legible.
model ApprovalRequest {
  id String @id @default(cuid())

  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  requestedByUserId String @map("requested_by_user_id")
  requestedBy       User   @relation("ApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  /// Null while pending, and for a cancellation: only the requester may withdraw
  /// their own request, so recording them as its reviewer would make every
  /// cancellation look like a self-approval.
  reviewedByUserId String? @map("reviewed_by_user_id")
  reviewedBy       User?   @relation("ApprovalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  targetType AuditTargetType @map("target_type")
  targetId   String          @map("target_id")

  /// The target's geography, so a request is visible to exactly the
  /// administrators the record itself is.
  wilayaId  String?  @map("wilaya_id")
  wilaya    Wilaya?  @relation(fields: [wilayaId], references: [id], onDelete: Restrict)
  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: Restrict)

  /// Exactly what would change, as a validated payload — the same shape the
  /// correction takes when it is applied, so approving cannot mean something
  /// different from what was asked.
  requestedChange Json @map("requested_change")

  /// Why it was asked for, and why it was decided. Neither may be blank.
  reason       String
  reviewReason String? @map("review_reason")

  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([wilayaId, createdAt])
  @@index([communeId, createdAt])
  @@index([targetType, targetId])
  @@map("approval_requests")
}

/// Where a historical fact came from. An enum rather than free text so a
/// record's provenance is always one of a known set — "who told us this?" is
/// half of whether it can be trusted.
enum ParticipationSource {
  /// Transcribed from paper registers or another pre-platform official record.
  LEGACY_IMPORT
  /// Derived from an Application this platform processed through a draw.
  APPLICATION
  /// Entered or amended by an administrator fixing a known error.
  ADMIN_CORRECTION

  @@map("participation_source")
}

/// What happened to one person in one previous draw year.
///
/// The third question in the model, distinct from the other two: Participant
/// answers "who is this person?", Application answers "how are they taking
/// part this year?", and this answers "what happened to them across previous
/// years?". Merging any two of them loses something — a person is not a year,
/// and an application is an intention, not an outcome.
///
/// This ledger is the future input to priority weighting. It stores facts, not
/// conclusions: no streak counter, no weight, nothing derived. Anything
/// computable from these rows is computed on demand, so a stored summary can
/// never drift from the rows it summarises.
model ParticipationHistory {
  id String @id @default(cuid())

  participantId String @map("participant_id")

  /// Where this person took part *that year*. Nobody belongs to a commune
  /// permanently, so the commune is a property of the year rather than of the
  /// participant, and it is what geographic authorization is decided on.
  ///
  /// Wilaya is deliberately not stored: the commune already determines it, and
  /// a second copy could disagree with the first.
  communeId String @map("commune_id")

  drawYear Int @map("draw_year")

  /// Whether the person took part in that year's draw. False is a *positive
  /// claim* that they did not — meaningfully different from having no row at
  /// all, which means the ledger simply has nothing authoritative to say.
  participated Boolean

  /// Whether they were selected. A CHECK constraint forbids winning a draw you
  /// did not take part in.
  won Boolean @default(false)

  source ParticipationSource

  /// Whether a human has confirmed this record against its source. Imported
  /// history lands as false and stays uncounted until someone vouches for it —
  /// see docs/participation-history.md.
  verified Boolean @default(false)

  /// Free text for provenance and uncertainty: which register, which page,
  /// what was illegible, why a correction was made. Never identity data.
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  commune     Commune     @relation(fields: [communeId], references: [id], onDelete: Restrict)

  /// Set only for a record a legacy import produced, and its route back to the
  /// register it was transcribed from.
  importRow    ImportRow?
  legacyWinner LegacyWinner?

  /// One person cannot have two contradictory stories about the same year.
  /// PostgreSQL decides this, so concurrent writes resolve correctly rather
  /// than both believing they checked first.
  @@unique([participantId, drawYear])
  /// The streak walk reads one participant's years in descending order.
  @@index([participantId, drawYear])
  /// The administrative view reads one commune's year.
  @@index([communeId, drawYear])
  @@map("participation_history")
}

/// One row per participant per application — the table that makes "at most
/// one application per person per draw year" a database guarantee.
///
/// Two unique constraints on Application alone cannot express the rule: a
/// person listed as primary on one application and secondary on another
/// satisfies both. Here every participant of every application occupies the
/// same (draw_year, participant_id) primary key regardless of role, so the
/// second attempt collides no matter which slot it arrives in — including
/// under concurrent requests, where the loser gets a clean constraint
/// violation instead of a lost update.
model ApplicationParticipant {
  applicationId String          @map("application_id")
  participantId String          @map("participant_id")
  drawYear      Int             @map("draw_year")
  role          ApplicationRole

  /// Composite reference: the year here is the application's own year, not a
  /// copy that could drift from it.
  application Application @relation(fields: [applicationId, drawYear], references: [id, drawYear], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// The constraint this table exists for.
  @@id([drawYear, participantId])
  /// One primary and at most one secondary per application.
  @@unique([applicationId, role])
  @@index([participantId])
  @@map("application_participants")
}

/// The file formats a legacy register may arrive in. Nothing else is parsed.
enum ImportSourceFormat {
  CSV
  XLSX

  @@map("import_source_format")
}

/// Where a batch stands.
///
/// The lifecycle exists to keep four things apart, because conflating any two of
/// them is how unreviewed historical data becomes authoritative: a file arriving,
/// its rows being checked, an administrator accepting it, and the authoritative
/// tables actually changing. Nothing before IMPORTED has touched a participant,
/// a historical record or anybody's winner status.
///
/// VALIDATING is a real state, not a formality. Staging and checking thousands of
/// rows is not one transaction, so a batch can genuinely be caught here — and one
/// stuck in VALIDATING is precisely what an administrator needs to see.
enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  READY_FOR_REVIEW
  /// Refused by a national administrator. Terminal.
  REJECTED
  /// Accepted, and still not written. Terminal only in the sense that it may
  /// now be executed.
  APPROVED
  /// The authoritative tables hold it. Terminal, and there is no un-import.
  IMPORTED
  /// The file itself could not be staged. Terminal.
  FAILED

  @@map("import_batch_status")
}

/// What validation concluded about one staged row.
///
/// CONFLICT and INVALID both block, and mean different things. INVALID is a row
/// that does not say anything usable — no national ID, an unparseable year.
/// CONFLICT is a well-formed row that disagrees with something: another row, a
/// known participant, an authoritative historical record. Only the second is a
/// question for a human.
enum ImportRowStatus {
  VALID
  WARNING
  CONFLICT
  INVALID

  @@map("import_row_status")
}

/// One uploaded legacy register, and everything that happened to it.
///
/// The batch is the unit of review and the unit of provenance: every imported
/// historical record and every legacy winner points back at the file it came
/// from, so "why does this person have four years of priority?" always has an
/// answer that names a source.
///
/// The uploaded file itself is *not* stored. It is parsed in memory, and what
/// survives is the staged rows, the checksum and this record — enough to review,
/// audit and explain the import without keeping a spreadsheet full of national
/// IDs on disk indefinitely. See docs/legacy-import.md.
model ImportBatch {
  id String @id @default(cuid())

  /// The name as uploaded, for recognition only. Never used as a path: nothing
  /// here ever opens a file by a name a client chose.
  sourceFilename String             @map("source_filename")
  sourceFormat   ImportSourceFormat @map("source_format")

  /// SHA-256 of the uploaded bytes. Unique, which is what makes re-uploading the
  /// same register report the existing batch instead of quietly duplicating
  /// thousands of historical records. An integrity and identity mechanism only —
  /// never a credential, and never proof that the *contents* are new.
  sourceChecksum String @unique @map("source_checksum")

  /// The span of draw years the file turned out to cover, derived from its rows
  /// once they are staged rather than declared by the uploader.
  drawYearStart Int? @map("draw_year_start")
  drawYearEnd   Int? @map("draw_year_end")

  status ImportBatchStatus @default(UPLOADED)

  /// Who uploaded it, and who accepted it. A CHECK constraint keeps them
  /// different people: separation of duties, in the database rather than only in
  /// a service a later refactor could simplify away.
  uploadedByUserId String @map("uploaded_by_user_id")
  uploadedBy       User   @relation("ImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId String? @map("approved_by_user_id")
  approvedBy       User?   @relation("ImportApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  /// Why it was accepted or refused. Mandatory for both, refused blank.
  reviewReason String? @map("review_reason")
  /// Why staging failed, where it did. Never the file's contents.
  failureReason String? @map("failure_reason")

  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")
  importedAt DateTime? @map("imported_at")

  rows          ImportRow[]
  legacyWinners LegacyWinner[]

  @@index([status, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@map("import_batches")
}

/// One line of an uploaded register, staged and checked before anything
/// authoritative is written.
///
/// Staging is the whole point. An uploaded spreadsheet is untrusted input, and
/// the cost of believing it is that somebody is excluded from the Hajj lottery
/// for the rest of their life on the strength of a mistyped cell. So a row lands
/// here first, is normalized by the same utilities the API uses, is checked
/// against the file and against the database, and only then — after a national
/// administrator has approved the batch — becomes a historical fact.
///
/// This table holds identity data by nature: a national ID is how a row is
/// matched to a person. That is why it is staging rather than a permanent store,
/// and why the audit trail records none of it.
model ImportRow {
  id String @id @default(cuid())

  importBatchId String      @map("import_batch_id")
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  /// The line in the source file, 1-based and counting the header, so a reviewer
  /// can find the row in the original register.
  rowNumber Int @map("row_number")

  /// Normalized by lib/national-id.ts, exactly as every other path into the
  /// system normalizes one — Arabic-Indic digits folded, separators stripped.
  /// Never the raw cell: a register written in Arabic digits must not create a
  /// second identity for somebody already known.
  nationalId String? @map("national_id")

  fullName    String? @map("full_name")
  dob         DateTime? @db.Date
  /// Canonical +213XXXXXXXXX, or null. Optional throughout: a paper register
  /// from 2009 has no phone number, and nothing here depends on one.
  phoneNumber String? @map("phone_number")

  /// The commune code as written, kept alongside the commune it resolved to so a
  /// reviewer can see what the register actually said.
  communeCode String  @map("commune_code")
  communeId   String? @map("commune_id")
  commune     Commune? @relation(fields: [communeId], references: [id], onDelete: Restrict)

  drawYear Int? @map("draw_year")

  /// Nullable on purpose, and this is load-bearing. An empty cell is an unknown,
  /// and an unknown is not a false — coercing it would manufacture a positive
  /// claim that somebody did not take part, which the ledger treats as
  /// authoritative knowledge. A missing value is a validation error instead.
  participated Boolean?
  won          Boolean?

  notes String?

  status ImportRowStatus @default(VALID)
  /// Every issue found, as `{ code, column, detail }` — codes from
  /// shared/src/import.ts, so the admin UI translates rather than parses prose.
  issues Json?

  /// Resolved during validation and confirmed during import. `participantId`
  /// being set does not mean anything was written: it means this row matched a
  /// person who already existed.
  participantId String?      @map("participant_id")
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// The historical record this row produced, once the batch was imported. Null
  /// for a row that was skipped because the ledger already held its year.
  participationHistoryId String?               @unique @map("participation_history_id")
  participationHistory   ParticipationHistory? @relation(fields: [participationHistoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  legacyWinner LegacyWinner?

  /// One line number per batch.
  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([communeId])
  @@index([nationalId, drawYear])
  @@map("import_rows")
}

/// One person's Hajj win from before this platform existed.
///
/// A deliberate second winner model rather than a nullable-column version of
/// `WinnerArchive`. An archived winner is the output of an executed draw: it
/// names a draw result, a pool entry and a selection order, none of which a paper
/// register from 2011 has or could have. Forcing legacy winners into that shape
/// would mean four nullable foreign keys and a row that claims to describe a draw
/// this system never ran — so the two provenances stay visibly different, and
/// "was this a web-era draw or a transcribed register?" is answered by which
/// table the row is in.
///
/// What the two share is the invariant that matters: `UNIQUE(participant_id)`,
/// one win per person for life. A legacy import naming somebody who has already
/// won — here or in a real draw — is a conflict for a human to resolve, never a
/// second lifetime win.
model LegacyWinner {
  id String @id @default(cuid())

  /// One legacy win per person, ever. The web-era counterpart is enforced
  /// separately by winner_archive; a person appearing in both is refused during
  /// validation and again inside the import transaction, since `has_won_hajj` is
  /// set by a compare-and-set that a concurrent real draw would lose.
  participantId String      @unique @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// The year and commune of the win, as the register recorded them.
  drawYear  Int     @map("draw_year")
  communeId String  @map("commune_id")
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Restrict)

  /// Provenance: which upload, which line of it, and which historical record it
  /// produced. A legacy winner is only ever as good as the register behind it,
  /// so the register is never more than one join away.
  importBatchId String      @map("import_batch_id")
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  importRowId String    @unique @map("import_row_id")
  importRow   ImportRow @relation(fields: [importRowId], references: [id], onDelete: Restrict)

  participationHistoryId String               @unique @map("participation_history_id")
  participationHistory   ParticipationHistory @relation(fields: [participationHistoryId], references: [id], onDelete: Restrict)

  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([drawYear])
  @@index([communeId, drawYear])
  @@map("legacy_winners")
}
