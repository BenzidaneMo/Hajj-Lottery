// Prisma schema.
// Lottery and annual application models are intentionally deferred to later
// steps. So far this covers the geographic hierarchy (wilaya/commune), the
// participant identity registry, and administrator authentication.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One of Algeria's 69 wilayas (provinces).
model Wilaya {
  id        String    @id @default(cuid())
  /// Official numeric wilaya code (e.g. "16" for Algiers).
  code      String    @unique
  nameAr    String    @map("name_ar")
  nameFr    String    @map("name_fr")
  /// No official English name exists; this holds the established Latin/French
  /// transliteration (nameFr) rather than an invented translation.
  nameEn    String    @map("name_en")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  communes  Commune[]
  admins    User[]

  @@map("wilayas")
}

/// One of Algeria's 1541 communes, each belonging to exactly one wilaya.
/// Each commune later runs its own independent lottery draw.
model Commune {
  id        String   @id @default(cuid())
  wilayaId  String   @map("wilaya_id")
  /// Official numeric commune code, unique within its wilaya.
  code      String
  nameAr    String   @map("name_ar")
  nameFr    String   @map("name_fr")
  /// No official English name exists; this holds the established Latin/French
  /// transliteration (nameFr) rather than an invented translation.
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  wilaya    Wilaya   @relation(fields: [wilayaId], references: [id])
  admins    User[]

  @@unique([wilayaId, code])
  /// Redundant on its own (id is already unique), but it gives User a
  /// composite foreign key target so PostgreSQL can enforce that an
  /// administrator's commune really belongs to their wilaya.
  @@unique([id, wilayaId])
  @@index([wilayaId])
  @@map("communes")
}

/// One real individual — the single identity record for one national ID.
///
/// A participant answers "who is this person?", never "how are they taking
/// part this year?". Draw year, commune, application status, computed weight
/// and entry type belong to the future annual-application models, which
/// reference this record instead of duplicating the person.
model Participant {
  id String @id @default(cuid())

  /// Algeria's Numéro d'Identification National, stored as the canonical
  /// 18-digit string produced by normalizeNationalId() — never a numeric
  /// type, so leading zeros survive. Uniqueness is enforced by PostgreSQL,
  /// not only by application code.
  nationalId String @unique @map("national_id")

  fullName String   @map("full_name")
  /// Date only; no time component, no timezone shifting.
  dob      DateTime @db.Date

  /// Permanent state: a past Hajj winner is excluded from future draws.
  /// Set transactionally by the later winner-processing step, never here.
  hasWonHajj Boolean @default(false) @map("has_won_hajj")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("participants")
}

/// Administrative hierarchy. Kept as a database enum so a role can only ever
/// be one of these values — never arbitrary user input. Mirrors ADMIN_ROLES
/// in shared/src/roles.ts; the server asserts the two agree at compile time.
enum AdminRole {
  SUPER_ADMIN
  WILAYA_ADMIN
  COMMUNE_ADMIN

  @@map("admin_role")
}

/// An administrator who can sign in to the admin portal.
///
/// Geographic scope is stored here and is the *only* authoritative source of
/// what this administrator may reach. It is never taken from the request.
model User {
  id String @id @default(cuid())

  /// Login identifier. Stored lowercase so it is effectively case-insensitive.
  username String @unique

  /// argon2id digest — never a plaintext or reversible value.
  passwordHash String @map("password_hash")

  role AdminRole

  /// Deactivated administrators keep their record but cannot authenticate.
  isActive Boolean @default(true) @map("is_active")

  /// Geographic scope, by role:
  ///   SUPER_ADMIN    both NULL           (national)
  ///   WILAYA_ADMIN   wilayaId only
  ///   COMMUNE_ADMIN  both set
  /// A CHECK constraint (see the migration) rejects any other combination.
  wilayaId  String? @map("wilaya_id")
  communeId String? @map("commune_id")

  /// Restrict, not Cascade: deleting geography must never silently widen or
  /// destroy an administrator's scope.
  wilaya Wilaya? @relation(fields: [wilayaId], references: [id], onDelete: Restrict)

  /// Composite reference on purpose. Pointing at (id, wilayaId) makes
  /// PostgreSQL reject a commune that belongs to a different wilaya than the
  /// one assigned here — the inconsistency cannot be written at all. With a
  /// NULL commune (SUPER_ADMIN, WILAYA_ADMIN) the constraint simply does not
  /// apply.
  commune Commune? @relation(fields: [communeId, wilayaId], references: [id, wilayaId], onDelete: Restrict)

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@index([wilayaId])
  @@index([communeId])
  @@map("users")
}

/// A server-side administrator session.
///
/// The cookie carries an opaque 256-bit token; only its SHA-256 digest is
/// stored here, so a leaked database dump cannot be replayed as a live
/// session. Deleting the row revokes the session immediately.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
