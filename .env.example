# -----------------------------------------------------------------------------
# Hajj Lottery — environment variables
# Copy this file to .env at the repository root and fill in real values.
# Never commit the real .env file.
# -----------------------------------------------------------------------------

# --- Database ------------------------------------------------------------------
# PostgreSQL connection string used by Prisma (server + migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hajj_lottery?schema=public"

# --- Server ----------------------------------------------------------------------
NODE_ENV="development"
PORT=4000

# Browser origins allowed to make credentialed API calls (CORS).
# Comma-separate for multiple origins. Never a wildcard: the session cookie is
# sent with credentials, and "*" is invalid (and unsafe) in that mode.
CLIENT_ORIGIN="http://localhost:5173"

# --- Admin authentication -----------------------------------------------------
# How long an admin session lasts before re-authentication is required.
SESSION_TTL_HOURS=8

# Development Super Admin, created by `npm run seed:admin`. Development only —
# the seed refuses to run with NODE_ENV=production. Leave these unset and no
# administrator is created; there is deliberately no default password anywhere.
# For production, see "First administrator" in docs/authentication.md.
DEV_ADMIN_USERNAME=""
DEV_ADMIN_PASSWORD=""

# Shared secret for the participant API, sent as the `x-internal-api-key`
# header. Temporary: it gates endpoints that expose personal data until admin
# authentication exists. Leave unset and those endpoints return 503 rather
# than becoming public. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=""

# Test database for `npm test`. Must be a DIFFERENT database from
# DATABASE_URL — the suite truncates tables between tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hajj-lottery-test?schema=public"

# --- Client (Vite) -----------------------------------------------------------------
# Must be prefixed with VITE_ to be exposed to the frontend bundle.
VITE_API_BASE_URL="http://localhost:4000"
