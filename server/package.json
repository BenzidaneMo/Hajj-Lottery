{
  "name": "@hajj-lottery/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx src/scripts/create-admin.ts",
    "admin:create": "tsx src/scripts/create-admin.ts --explicit",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hajj-lottery/shared": "*",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^5.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
